---
import { Picture } from 'astro:assets'

const { picture, pictureAlt, reverse } = Astro.props
---

<div class={'mt-10 grid grid-cols-none gap-10 px-5 lg:grid-cols-2'}>
  <div>
    <Picture
      alt={pictureAlt}
      src={picture}
      formats={['avif', 'webp']}
      layout="full-width"
    />
  </div>
  <div
    class:list={[
      'grow self-center -mt-10',
      reverse ? 'lg:text-right lg:order-first' : 'lg:text-left',
    ]}
  >
    <slot />
  </div>
</div>
