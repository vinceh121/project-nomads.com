---
import { Picture } from "astro:assets";

const { picture, pictureAlt, reverse } = Astro.props;
---

<div
  class={"mt-10 flex flex-col lg:flex-row gap-10 px-5" +
    (reverse ? " lg:flex-row-reverse" : "")}
>
  <div>
    <Picture
      alt={pictureAlt}
      src={picture}
      formats={["avif", "webp"]}
      layout="full-width"
    />
  </div>
  <div
    class={"grow self-center -mt-10" +
      (reverse ? " lg:text-right" : " lg:text-left")}
  >
    <slot />
  </div>
</div>
