---
import { Picture } from "astro:assets";

const { picture, pictureAlt, reverse } = Astro.props;
---

<div class={"flex flex-row gap-10" + (reverse ? " flex-row-reverse" : "" )}>
	<div class="w-100">
		<Picture
			alt={pictureAlt}
			src={picture}
			formats={["avif", "webp"]}
			layout="full-width"
		/>
	</div>
	<div class="grow self-center">
		<slot />
	</div>
</div>
