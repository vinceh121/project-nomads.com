---
import Source from "./Source.astro";
import Trans from "../Trans.astro";

const { id, language, sources } = Astro.props as {
  id: string;
  language: string;
  sources: Array<{ href: string; image: string; title: string }>;
};
---

<h3 id={id} class="text-3xl pt-20 pb-5">
  <a href={"#" + id} class="no-underline"><Trans>{language}</Trans></a>
</h3>

<ul class="grid lg:grid-cols-3 gap-5 col-span-full justify-items-center">
  {
    sources.map(({ href, image, title }) => (
      <Source href={href} image={image} title={title} />
    ))
  }
</ul>
