---
import myabandonware from '../../assets/myabandonware.png'
import internetarchive from '../../assets/internetarchive.png'
import oldnomads from '../../assets/old_nomads.png'
import Picture from 'astro/components/Picture.astro'
import Trans from '../Trans.astro'

const { title, href, image } = Astro.props as {
  title?: string
  href: string
  image: 'myabandonware' | 'internetarchive'
}

const actualImage = {
  myabandonware,
  internetarchive,
  oldnomads,
}[image]

const anchorAttrs = href.startsWith('/') ? {} : { target: '_blank' }
---

<li class="size-50">
  <a
    href={href}
    class="relative flex flex-col items-center justify-center p-2 size-full border border-gold/60 hover:border-gold transition-colors"
    {...anchorAttrs}
  >
    <Picture src={actualImage} alt="" height="128" />
    {
      title && (
        <h4 class="absolute bottom-0.5">
          <Trans>{title}</Trans>
        </h4>
      )
    }
  </a>
</li>
