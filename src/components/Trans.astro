---
import { gettext } from "../i18n";

const key = (await Astro.slots.render("default")).trim().replaceAll(/\s+/g, " ");
const value = gettext(Astro.currentLocale, key);

if (!value) {
	Astro.logger?.warn(`Undefined translation key for ${Astro.currentLocale}: ${JSON.stringify(key)}`);
}
---

<Fragment set:html={value ?? key} />
