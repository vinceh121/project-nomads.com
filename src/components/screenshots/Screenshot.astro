---
import { Image, getImage } from "astro:assets";

const { screenshot, caption } = Astro.props;

const href = await getImage({ src: screenshot });
---

<a
  href={href.src}
  data-lightbox="gallery"
  data-caption={caption}
  data-astro-reload
>
  <Image src={screenshot} alt={caption} height={128} />
</a>
