---
import BasicLayout from "../layouts/BasicLayout.astro";
import Trans from "../components/Trans.astro";
import { gettext } from "../i18n";
---

<BasicLayout
  title={gettext(Astro.currentLocale, "Community")}
  description={gettext(
    Astro.currentLocale,
    "Engage in the Project Nomads community.",
  )}
>
  <p>
    <Trans>
      You can join our <a href="https://discord.gg/j3sKWc8YQd" target="_blank"
        >Discord</a
      >!
      <br />
      There, you can find custom maps, missions, graphic mods, and discuss the game.
    </Trans>
  </p>

  <p>
    <Trans>
      You can also find mods on <a
        href="https://www.nexusmods.com/games/projectnomads"
        target="_blank">NexusMods</a
      > and <a
        href="https://www.moddb.com/games/project-nomads/addons"
        target="_blank">ModDB</a
      >.
    </Trans>
  </p>
</BasicLayout>
