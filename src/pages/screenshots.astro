---
import BasicLayout from "../layouts/BasicLayout.astro";
import firstSkritIsland from "../assets/screenshots/first-skrit-island.png";
import athanor from "../assets/screenshots/athanor.png";
import Screenshot from "../components/screenshots/Screenshot.astro";
import { gettext } from "../i18n";

const screenshots = [
  {
    screenshot: firstSkritIsland,
    caption: "Discover long lost islands",
  },
  {
    screenshot: athanor,
    caption: "Great steampunk machines",
  },
].map((s) => ({
  ...s,
  caption: gettext(Astro.currentLocale, s.caption) ?? "",
}));
---

<BasicLayout>
  <div class="flex gap-10 flex-wrap">
    {
      screenshots.map(({ screenshot, caption }) => (
        <Screenshot screenshot={screenshot} caption={caption} />
      ))
    }
  </div>
</BasicLayout>

<script>
  import { Lightbox } from "lightbox3";

  Lightbox.init();
</script>

<style is:global>
  @import "../../node_modules/lightbox3/dist/lightbox3.css";
</style>
