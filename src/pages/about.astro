---
import BasicLayout from "../layouts/BasicLayout.astro";
import Trans from "../components/Trans.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { gettext } from "../i18n";

const community = getRelativeLocaleUrl(
  Astro.currentLocale ?? "en",
  "/community/",
);
---

<BasicLayout
  title={gettext(Astro.currentLocale, "About")}
  description={gettext(Astro.currentLocale, "About Project Nomads.")}
>
  <Trans>
    <p>
      This is a fan website made with ❤️ by <a href="https://vinceh121.me"
        >vinceh121</a
      > and the <a href={community}>community</a>.
    </p>
    <p>
      Not affiliated with any former or current companies officially related to
      Project Nomads.
    </p>
  </Trans>
</BasicLayout>
