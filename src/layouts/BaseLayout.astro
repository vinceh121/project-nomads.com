---
import { ClientRouter } from "astro:transitions";

const { title, description } = Astro.props;
const fullTitle = title + " – Project Nomads";
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={Astro.currentLocale ?? "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#c97515" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:url" content={"https://project-nomads.com" + path} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:image" content="https://project-nomads.com/hero.webp" />
    <meta property="og:site_name" content="Project Nomads" />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://project-nomads.com/hero.webp" />

    <title>{fullTitle}</title>

    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
