---
import { getRelativeLocaleUrl } from "astro:i18n";
import "../styles/global.css";
import BaseLayout from "./BaseLayout.astro";
import Trans from "../components/Trans.astro";

const paths = [
  { path: "/", name: "Game" },
  { path: "/screenshots/", name: "Screenshots" },
  { path: "/download/", name: "Download" },
  { path: "/community/", name: "Community" },
  { path: "/about/", name: "About" },
].map((path) => ({
  ...path,
  path: getRelativeLocaleUrl(Astro.currentLocale ?? "en", path.path),
}));

const languages = [
  {
    code: "en",
    label: "🇬🇧 English",
  },
  {
    code: "de",
    label: "🇩🇪 German",
  },
  {
    code: "fr",
    label: "🇫🇷 French",
  },
  {
    code: "it",
    label: "🇮🇹 Italian",
  },
  {
    code: "ru",
    label: "🇷🇺 Russian",
  },
  {
    code: "cz",
    label: "🇨🇿 Czech",
  },
];
---

<BaseLayout>
  <nav
    class="w-full flex flex-col lg:flex-row text-center justify-evenly text-bronze font-gabriela font-bold text-xl py-3 bg-neutral-950/20 lg:absolute lg:top-0 lg:z-10"
  >
    {
      paths.map(({ path, name }) => (
        <a
          class="duration-150 transition-all hover:brightness-150 hover:drop-shadow-lg hover:drop-shadow-bronze text-bronze no-underline"
          href={path}
        >
          {name}
        </a>
      ))
    }
  </nav>

  <slot />

  <footer class="bg-neutral-900 text-neutral-400 mt-50 py-10">
    <div class="mx-auto px-5 gap-5 grid lg:grid-cols-3 lg:w-400 lg:gap-75">
      <div>
        <Trans>
          Fan website not affiliated with any company related to Project Nomads
        </Trans>
      </div>

      <div>
        <a
          href={`https://weblate.vinceh121.me/engage/project-nomads-website/-/${Astro.currentLocale}/`}
          class="text-neutral-400 no-underline hover:underline"
        >
          <Trans>Help translate this website</Trans>
        </a>
      </div>

      <div>
        <select id="languageSelect">
          {
            languages.map(({ code, label }) => (
              <option
                class="bg-neutral-950"
                value={code}
                selected={code === Astro.currentLocale}
              >
                {label}
              </option>
            ))
          }
        </select>
      </div>
    </div>
  </footer>
</BaseLayout>

<script>
  import { navigate } from "astro:transitions/client";

  document.addEventListener("astro:page-load", () => {
    const langSelect = document.getElementById(
      "languageSelect",
    ) as HTMLSelectElement;

    langSelect.addEventListener("input", () => {
      const toLang = langSelect.value;
      const currentLang = document.documentElement.lang;

      if (currentLang === toLang) {
        return;
      }

      let path;

      if (currentLang === "en") {
        path = `/${toLang}${location.pathname}`;
      } else if (toLang === "en") {
        path = location.pathname.replace(`/${currentLang}/`, "/");
      } else {
        path = location.pathname.replace(`/${currentLang}/`, `/${toLang}/`);
      }

      navigate(path);
    });
  });
</script>
