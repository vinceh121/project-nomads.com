---
import { getRelativeLocaleUrl } from "astro:i18n";
import "../styles/global.css";
import BaseLayout from './BaseLayout.astro'

const paths = [
    {path: '/', name: 'Game'},
    {path: '/screenshots/', name: 'Screenshots'},
    {path: '/download/', name: 'Download'},
    {path: '/community/', name: 'Community'},
    {path: '/about/', name: 'About'},
].map(path => ({...path, path: getRelativeLocaleUrl(Astro.currentLocale ?? 'en', path.path)}));
---

<BaseLayout>
    <nav class="w-full flex justify-evenly text-bronze font-gabriela font-bold text-xl py-3 bg-neutral-950/20 absolute top-0 z-10">
        {
            paths.map(
                ({path, name}) =>
                    <a class="duration-150 transition-all hover:brightness-150 hover:drop-shadow-lg hover:drop-shadow-bronze text-bronze no-underline" href={path}>{name}</a>
            )
        }
    </nav>

    <slot/>
</BaseLayout>
